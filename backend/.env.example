# Copy this file to `.env` and fill in values as needed.

# GROQ (OpenAI-compatible HTTP API). Leave empty to use the fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=60

# Supabase Credentials
SUPABASE_URL=
SUPABASE_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Retrieval / reranking
RETRIEVAL_K=10
RERANK_K=5

# Security
# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000

# Development-only authentication test endpoints.
ENABLE_AUTH_TEST_ROUTES=false

HR365_ENCRYPTION_KEY=replace-with-a-strong-random-secret