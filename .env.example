# ---------------------------------------------------------------------------
# HR365 RAG backend configuration
# Copy this file to `.env` and fill in values as needed.
# Every variable is optional - the project runs with sensible defaults.
# ---------------------------------------------------------------------------

# GROQ (OpenAI-compatible HTTP API). Leave empty to use the fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=60

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Retrieval / reranking
RETRIEVAL_K=10
RERANK_K=5